// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // window
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 1.0,
  },
  "gutter": {
    "git_gutter_width": {
      "custom": 8.0,
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "theme": {
    "mode": "dark",
    "light": "Prismatic Pink Light",
    "dark": "Prismatic Pink",
  },
  "minimap": {
    "show": "never",
  },
  "scrollbar": {
    "show": "always",
  },
  "ui_font_weight": 400.0,
  "ui_font_size": 16.0,
  "ui_font_family": "Lexend Deca",
  "window_decorations": "client",

  // panels
  "file_finder": {
    "file_icons": true,
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "outline_panel": {
    //"dock": "left",
    "auto_fold_dirs": false,
    "indent_size": 16.0,
    "button": true,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "auto_reveal_entries": false,
    "bold_folder_labels": true,
    "button": true,
    "default_width": 240.0,
    "diagnostic_badges": true,
    //"dock": "left",
    "entry_spacing": "standard",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "git_status_indicator": true,
    "hide_gitignore": false,
    "hide_hidden": false,
    "hide_root": false,
    "indent_size": 10.0,
    "sticky_scroll": true,
  },

  // toolbar
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": false,
    "show_close_button": "hover",
  },
  "title_bar": {
    "show_project_items": true,
    "show_menus": true,
  },

  // editor
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "middle_click_paste": false,
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
  },
  "search_wrap": true,
  "soft_wrap": "none",

  // text buffer
  "buffer_font_family": "IosevkaLegible",
  "buffer_font_fallbacks": [
    "IosevkaLegible",
    "IosevkaRoundMinimal",
    "iMWritingDuo Nerd Font",
    "Illinois Mono",
  ],
  "buffer_font_features": {
    "calt": false, // no ligatures
  },
  "buffer_font_size": 13.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": {
    "custom": 1.25,
  },
  "colorize_brackets": true,
  "document_folding_ranges": "on",
  "document_symbols": "on",
  "inlay_hints": {
    "enabled": true,
    "show_background": false,
    "toggle_on_modifiers_press": {
      "control": true,
      "alt": true,
    },
  },
  "hide_mouse": "never",
  "indent_guides": {
    "active_line_width": 2,
    "background_coloring": "disabled",
    "coloring": "indent_aware",
    "line_width": 1,
  },
  "preferred_line_length": 100,
  "redact_private_values": false,
  "rounded_selection": false,
  "semantic_tokens": "combined",
  "show_whitespaces": "all",
  "text_rendering_mode": "platform_default",
  "wrap_guides": [80, 100, 120],

  // files
  "hidden_files": [], // DO NOT HIDE ANY FILES
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    //"**/.classpath",
    "**/.settings",
  ],

  // terminal
  "terminal": {
    "shell": {
      "program": "fish",
    },
    "font_family": "IosevkaLegible",
    "font_fallbacks": ["IosevkaLegible", "Iosevka"],
    "line_height": {
      "custom": 1.1,
    },
    "max_scroll_history_lines": 10000,
  },

  // vcs
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },

  // language
  "languages": {
    "Markdown": {
      "soft_wrap": "none",
      "tab_size": 2,
    },
    "Rust": {
      "tab_size": 4,
    },
    "Python": {
      "tab_size": 4,
    },
  },

  // agents
  "disable_ai": false,
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // system
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": false,
  },
  "ssh_connections": [
    {
      "host": "relay",
      "args": [],
      "projects": [
        {
          "paths": ["/home/xiej"],
        },
      ],
    },
  ],
  "use_podman": true,
  "use_system_path_prompts": true,
}
